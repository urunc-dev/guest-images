version: v0.1

platforms:
  framework: linux
  monitor: firecracker
  architecture: x86

rootfs:
  # An initrd with clis and urunit 86913f1, built by prebuild.sh.
  from: local
  path: rootfs.cpio
  type: initrd

kernel:
  # The linux/amd64 entry of linux-kernel:generic (Linux 6.18.57).
  from: ghcr.io/urunc-dev/guest-images/linux-kernel@sha256:21a9fa9da48c7d8ebeb8194b779e807ed99cd2220f08eda8b450bf23f97e9385
  path: /.boot/kernel

# urunc's tests replace the whole command, so urunit is part of it rather
# than the entrypoint.
cmd: ["/urunit", "/clis", "Hello", "world"]
